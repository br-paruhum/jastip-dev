# ProxyBuying staging vhost. Canonical host = stg.proxybuying.com.
# Legacy stg.jastip.me 301-redirects to stg.proxybuying.com (reuses the old origin cert).
# TLS uses the wildcard Cloudflare Origin cert for *.proxybuying.com.

# HTTP (both hosts) -> HTTPS stg.proxybuying.com
server {
    listen 80;
    listen [::]:80;
    server_name stg.proxybuying.com stg.jastip.me;
    return 301 https://stg.proxybuying.com$request_uri;
}

# HTTPS legacy stg.jastip.me -> stg.proxybuying.com (reuses old origin cert)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name stg.jastip.me;

    ssl_certificate     /etc/ssl/cloudflare/stg.jastip.me.pem;
    ssl_certificate_key /etc/ssl/cloudflare/stg.jastip.me.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://stg.proxybuying.com$request_uri;
}

# HTTPS stg.proxybuying.com — the application
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name stg.proxybuying.com;

    ssl_certificate     /etc/ssl/cloudflare/proxybuying.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/proxybuying.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 5M;

    location /static/ {
        alias /var/www/jastip-stg/staticfiles/;
        access_log off;
        expires 30d;
        include /etc/nginx/snippets/jastip-security-headers.conf;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }
    location /media/ {
        alias /var/www/jastip-stg/media/;
        expires 7d;
        include /etc/nginx/snippets/jastip-security-headers.conf;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8019;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        include /etc/nginx/snippets/jastip-security-headers-admin.conf;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8019;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        include /etc/nginx/snippets/jastip-security-headers.conf;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
}
