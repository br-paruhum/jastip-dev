# ProxyBuying production vhost. Canonical host = www.proxybuying.com; apex 301s to www.
# The legacy jastip.me hosts 301-redirect to the matching proxybuying.com URL so old
# links/SEO keep working (Cloudflare also fronts both zones at the edge).
# Install:
#   sudo cp jastip-prd.nginx /etc/nginx/sites-available/jastip-prd
#   sudo cp security-headers.conf /etc/nginx/snippets/jastip-security-headers.conf
#   sudo cp security-headers-admin.conf /etc/nginx/snippets/jastip-security-headers-admin.conf
#   sudo ln -s /etc/nginx/sites-available/jastip-prd /etc/nginx/sites-enabled/   # (already linked)
#   sudo nginx -t && sudo systemctl reload nginx
# TLS uses the Cloudflare Origin cert for proxybuying.com (covers proxybuying.com + *.proxybuying.com):
#   sudo cp cert.txt /etc/ssl/cloudflare/proxybuying.com.pem
#   sudo cp key.txt  /etc/ssl/cloudflare/proxybuying.com.key   # chmod 600
# The jastip.me redirect blocks keep using the existing /etc/ssl/cloudflare/jastip.me.* cert.

# HTTP (all hosts) -> HTTPS www.proxybuying.com
server {
    listen 80;
    listen [::]:80;
    server_name proxybuying.com www.proxybuying.com jastip.me www.jastip.me;
    return 301 https://www.proxybuying.com$request_uri;
}

# HTTPS legacy jastip.me (apex + www) -> proxybuying.com  (reuses old origin cert)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name jastip.me www.jastip.me;

    ssl_certificate     /etc/ssl/cloudflare/jastip.me.pem;
    ssl_certificate_key /etc/ssl/cloudflare/jastip.me.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://www.proxybuying.com$request_uri;
}

# HTTPS apex proxybuying.com -> www (canonical)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name proxybuying.com;

    ssl_certificate     /etc/ssl/cloudflare/proxybuying.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/proxybuying.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://www.proxybuying.com$request_uri;
}

# HTTPS www.proxybuying.com — the application
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name www.proxybuying.com;

    ssl_certificate     /etc/ssl/cloudflare/proxybuying.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/proxybuying.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 5M;

    location /static/ {
        alias /var/www/jastip-prd/staticfiles/;
        access_log off;
        expires 30d;
        include /etc/nginx/snippets/jastip-security-headers.conf;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }
    location /media/ {
        alias /var/www/jastip-prd/media/;
        expires 7d;
        include /etc/nginx/snippets/jastip-security-headers.conf;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        include /etc/nginx/snippets/jastip-security-headers-admin.conf;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        include /etc/nginx/snippets/jastip-security-headers.conf;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
}
