# Copy to .env and fill in. See README for details.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8019,http://127.0.0.1:8019
SITE_DOMAIN=localhost:8019
TIME_ZONE=Asia/Jakarta

# Postgres on staging/prod; blank = SQLite locally
DATABASE_URL=postgres://jastip:jastip@127.0.0.1:5432/jastip_dev

EMAIL_USE_SMTP=False
EMAIL_HOST=mail.proxybuying.com
EMAIL_PORT=587
EMAIL_HOST_USER=admin@proxybuying.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ProxyBuying <admin@proxybuying.com>
ADMIN_EMAIL=admin@proxybuying.com

PLATFORM_COMMISSION_PERCENT=2.5

WHATSAPP_ENABLED=False
WHATSAPP_BOT_URL=http://127.0.0.1:8090
WHATSAPP_BOT_TOKEN=change-me

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# Cloudflare Turnstile (contact form anti-spam). Blank = widget/verification skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
